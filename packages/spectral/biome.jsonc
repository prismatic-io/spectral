{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "extends": ["../../biome.jsonc"],
  "plugins": ["../../biome-plugins/no-constructor-name.grit"],
  "files": {
    "includes": ["!**/dist", "!**/node_modules", "!**/bin"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noEmptyInterface": "off",
        "noShadowRestrictedNames": "off",
        "noDoubleEquals": "off",
        "noConfusingVoidType": "off"
      },
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lodash": "Import from lodash/{package}"
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/src/types/**/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  ".": "Import types directly from specific files instead of the generic index",
                  "..": "Import types directly from specific files instead of the generic index",
                  "../types": "Import types directly from specific files instead of the generic index"
                },
                "patterns": [
                  {
                    "group": ["@prismatic-io/spectral/dist", "@prismatic-io/spectral/dist/**"],
                    "message": "dist/ paths are deprecated and will be removed. Import from @prismatic-io/spectral, @prismatic-io/spectral/http, or @prismatic-io/spectral/testing instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
