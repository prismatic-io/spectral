{
  "compilerOptions": {
    "target": "es6",
    "module": "nodenext",
    "lib": ["esnext", "DOM"],
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src"]
}
