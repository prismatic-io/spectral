{
  // Its own program: config-var types change with augmentation, which is global to a
  // program, and the tsd program augments IntegrationDefinitionConfiguration.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["index.ts"]
}
