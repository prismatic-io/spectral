{
  // Emits declarations for index.ts, a callable package's entry, as a component's npm build
  // does: through spectral's package exports, so every type they name must be public.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["index.ts"]
}
